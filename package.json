{
  "name": "fibemate-core",
  "version": "0.1.1",
  "description": "FIBEMATE post-quantum crypto core — ML-KEM-768 (FIPS 203) pure-JS reference implementation",
  "type": "commonjs",
  "author": "刘天赫 <research@fibemate.net>",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./kem/ml-kem-768": "./src/kem/ml-kem-768.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/kem/ml-kem-768.js",
    "src/kem/fips203.js",
    "src/kem/params.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:mutation": "node scripts/mutation-check.cjs",
    "test:coverage": "c8 --all --include=\"index.js\" --include=\"src/**/*.js\" --exclude=\"test/**\" --check-coverage --lines 90 --functions 90 --branches 80 --reporter=text node --test"
  },
  "keywords": [
    "pqc",
    "post-quantum",
    "ml-kem",
    "ml-kem-768",
    "fips-203",
    "cryptography",
    "kem",
    "nist"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lennonhaha/fibemate-core.git"
  },
  "devDependencies": {
    "@noble/post-quantum": "^0.7.1",
    "c8": "^12.0.0"
  }
}
